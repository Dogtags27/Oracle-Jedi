{
  "name": "oracle-jedi",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "backend",
    "frontend",
    "extension"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:extension": "npm run dev -w extension",
    "build": "npm run build -w frontend && npm run build -w extension",
    "test": "npm test -w core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke -w backend",
    "smoke:ui": "node scripts/ui-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
